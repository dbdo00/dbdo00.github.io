&lt;pre&gt;&lt;code class=&quot;language-python&quot;&gt;&lt;div class=&quot;highlight&quot;&gt;&lt;pre&gt;&lt;span&gt;&lt;/span&gt;&lt;span class=&quot;c1&quot;&gt;# step size for the sliding window&lt;/span&gt;
